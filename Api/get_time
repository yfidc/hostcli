<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>显示当前时间戳</title>
</head>
<body>
    <p id="timestamp"></p>

    <script>
        // 获取当前时间的时间戳（毫秒）
        var timestamp = Math.floor(new Date().getTime() / 1000);
        // 将时间戳转换为人类可读的格式（可选）
        var formattedTimestamp = new Date(timestamp).toLocaleString();
        // 显示时间戳
        document.getElementById('timestamp').innerText = timestamp;
        // 或者显示格式化的时间字符串（可选）
        // document.getElementById('timestamp').innerText = "当前时间: " + formattedTimestamp;
    </script>
</body>
</html>
